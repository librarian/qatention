set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME MinGW)
set(SPDLOG_WCHAR_FILENAMES ON)
set(VCPKG_ENV_PASSTHROUGH_UNTRACKED PATH)
if(CMAKE_HOST_UNIX)
    set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../toolchains/mingw64.cmake")
    if(PORT STREQUAL "nspr")
        # NSPR's configure searches for unprefixed windres even in a cross build.
        find_program(nspr_windres x86_64-w64-mingw32-windres REQUIRED)
        list(APPEND VCPKG_MAKE_CONFIGURE_OPTIONS "ac_cv_path_WINDRES=${nspr_windres}")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/nss-options.cmake")
