set(CMAKE_SYSTEM_NAME Darwin)
if(VCPKG_TARGET_ARCHITECTURE STREQUAL "arm64")
    set(CMAKE_SYSTEM_PROCESSOR arm64)
elseif(VCPKG_TARGET_ARCHITECTURE STREQUAL "x64")
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
elseif(CMAKE_OSX_ARCHITECTURES MATCHES "^(arm64|x86_64)$")
    # vcpkg defines TARGET_ARCHITECTURE inside dependency builds, but not
    # when chainloading this file for the application itself.
    set(CMAKE_SYSTEM_PROCESSOR "${CMAKE_OSX_ARCHITECTURES}")
else()
    message(FATAL_ERROR "Set CMAKE_OSX_ARCHITECTURES to arm64 or x86_64 for osxcross")
endif()
set(CMAKE_OSX_ARCHITECTURES "${CMAKE_SYSTEM_PROCESSOR}" CACHE STRING "")
set(CMAKE_OSX_DEPLOYMENT_TARGET 12.0 CACHE STRING "")
set(CMAKE_OSX_SYSROOT "$ENV{OSXCROSS_ROOT}/SDK/MacOSX14.5.sdk" CACHE PATH "")
set(CMAKE_C_COMPILER "$ENV{OSXCROSS_ROOT}/bin/${CMAKE_SYSTEM_PROCESSOR}-apple-darwin23.5-clang")
set(CMAKE_CXX_COMPILER "$ENV{OSXCROSS_ROOT}/bin/${CMAKE_SYSTEM_PROCESSOR}-apple-darwin23.5-clang++")
# Chainloading replaces vcpkg's standard macOS toolchain, so forward its
# linker flags explicitly. vcpkg's Make/GYP ports read these through CMake.
if(NOT QATENTION_OSXCROSS_LINKER_FLAGS_SET)
    set(QATENTION_OSXCROSS_LINKER_FLAGS_SET TRUE)
    foreach(kind EXE SHARED MODULE)
        string(APPEND CMAKE_${kind}_LINKER_FLAGS_INIT " ${VCPKG_LINKER_FLAGS}")
        string(APPEND CMAKE_${kind}_LINKER_FLAGS_DEBUG_INIT " ${VCPKG_LINKER_FLAGS_DEBUG}")
        string(APPEND CMAKE_${kind}_LINKER_FLAGS_RELEASE_INIT " ${VCPKG_LINKER_FLAGS_RELEASE}")
    endforeach()
endif()
list(APPEND CMAKE_FIND_ROOT_PATH ${CMAKE_PREFIX_PATH})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
