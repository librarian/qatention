set(QATENTION_SANITIZER "" CACHE STRING "Sanitizer: address, undefined, address-undefined, thread, memory")
set_property(CACHE QATENTION_SANITIZER PROPERTY STRINGS "" address undefined address-undefined thread memory)
if(NOT QATENTION_SANITIZER)
    return()
endif()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" OR WIN32 OR ANDROID)
    message(FATAL_ERROR "Sanitizer builds require a native GCC/Clang Unix toolchain")
endif()
if(QATENTION_SANITIZER STREQUAL "address-undefined")
    set(sanitizer_flags -fsanitize=address,undefined)
elseif(QATENTION_SANITIZER MATCHES "^(address|undefined|thread)$")
    set(sanitizer_flags -fsanitize=${QATENTION_SANITIZER})
elseif(QATENTION_SANITIZER STREQUAL "memory")
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR NOT QATENTION_NATIVE_TESTS_ONLY)
        message(FATAL_ERROR "MSan requires Clang and QATENTION_NATIVE_TESTS_ONLY=ON: prebuilt Qt is not MSan-instrumented")
    endif()
    set(sanitizer_flags -fsanitize=memory -fsanitize-memory-track-origins=2)
else()
    message(FATAL_ERROR "Unknown QATENTION_SANITIZER: ${QATENTION_SANITIZER}")
endif()
# Keep reports actionable and fail the test on the first UB or race.
add_compile_options(${sanitizer_flags} -fno-omit-frame-pointer -g -fno-sanitize-recover=all)
add_link_options(${sanitizer_flags})
if(QATENTION_SANITIZER MATCHES "^(thread|memory)$")
    add_compile_options(-fPIE)
    add_link_options(-pie)
endif()
