# NBS-inspired checks, scoped to correctness rather than NBS-specific names.
# Qt APIs and existing public identifiers retain their naming conventions.
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  modernize-use-override,
  modernize-use-nullptr,
  readability-misleading-indentation
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(src|tests|third_party/aspeed)/.*'
FormatStyle: file
# All supported compilers implement pragma once; retain the existing header style.
